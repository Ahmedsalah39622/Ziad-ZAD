<!-- ============================================================ -->
<!-- GENERIC PAGE — page.liquid (legal pages, about, FAQ etc.)   -->
<!-- ============================================================ -->

<article class="page-content">
  <div class="container page-content__inner">
    <p class="page-content__eyebrow">{{ page.metafields.custom.category | default: 'Legal' | upcase }}</p>
    <h1 class="page-content__title">{{ page.title }}</h1>
    <div class="page-content__body rte">
      {{ page.content }}
    </div>
  </div>
</article>
