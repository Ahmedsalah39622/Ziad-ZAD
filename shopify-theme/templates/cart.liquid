<!-- ============================================================ -->
<!-- CART PAGE — cart.liquid                                      -->
<!-- ============================================================ -->

<div class="cart-page">
  <div class="container cart-page__inner">

    <!-- Header -->
    <div class="cart-page__header">
      <div>
        <h1 class="cart-page__title">Your Cart</h1>
        <p class="cart-page__count">
          {% if cart.item_count == 1 %}1 Item{% else %}{{ cart.item_count }} Items{% endif %}
        </p>
      </div>
      <a href="/collections/all" class="cart-page__continue">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        Continue Shopping
      </a>
    </div>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart, id: 'cart-form', class: 'cart-form' -%}
      <div class="cart-layout">

        <!-- Cart Items -->
        <div class="cart-items">
          {%- for item in cart.items -%}
            <div class="cart-item" data-line="{{ forloop.index }}">
              <!-- Product Image -->
              <a href="{{ item.url }}" class="cart-item__image-wrap">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 300 }}"
                    alt="{{ item.title }}"
                    class="cart-item__image"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="cart-item__image-placeholder">{{ item.title | slice: 0, 2 | upcase }}</div>
                {%- endif -%}
              </a>

              <!-- Details -->
              <div class="cart-item__details">
                <div class="cart-item__top">
                  <div>
                    <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title }}</a>
                    {%- unless item.variant.title == 'Default Title' -%}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                  </div>
                  <p class="cart-item__price">{{ item.final_line_price | money }}</p>
                </div>

                <div class="cart-item__bottom">
                  <!-- Quantity -->
                  <div class="qty-control">
                    <button
                      type="button"
                      class="qty-control__btn"
                      onclick="updateCartLine({{ forloop.index }}, {{ item.quantity | minus: 1 }})"
                      aria-label="Decrease quantity"
                    >−</button>
                    <span class="qty-control__value">{{ item.quantity }}</span>
                    <button
                      type="button"
                      class="qty-control__btn"
                      onclick="updateCartLine({{ forloop.index }}, {{ item.quantity | plus: 1 }})"
                      aria-label="Increase quantity"
                    >+</button>
                  </div>

                  <!-- Remove -->
                  <button
                    type="button"
                    class="cart-item__remove"
                    onclick="updateCartLine({{ forloop.index }}, 0)"
                    aria-label="Remove {{ item.title }}"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Cart Summary -->
        <div class="cart-summary">
          <h2 class="cart-summary__title">Order Summary</h2>

          <div class="cart-summary__rows">
            <div class="cart-summary__row">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-summary__row">
              <span>Shipping</span>
              <span class="cart-summary__shipping-note">Calculated at checkout</span>
            </div>
            {%- if cart.total_discounts > 0 -%}
              <div class="cart-summary__row cart-summary__row--discount">
                <span>Discounts</span>
                <span>−{{ cart.total_discounts | money }}</span>
              </div>
            {%- endif -%}
          </div>

          <div class="cart-summary__divider"></div>

          <div class="cart-summary__total">
            <span>Total</span>
            <span class="cart-summary__total-value">{{ cart.total_price | money }}</span>
          </div>

          <!-- Note -->
          <div class="cart-summary__note">
            <label for="cart-note" class="cart-summary__note-label">Order Note (optional)</label>
            <textarea
              id="cart-note"
              name="note"
              class="cart-summary__note-input"
              placeholder="Special instructions..."
              rows="3"
            >{{ cart.note }}</textarea>
          </div>

          <a href="/checkout" class="btn btn--primary btn--full btn--large cart-summary__checkout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            Proceed to Checkout
          </a>

          <p class="cart-summary__security">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Secure SSL Encrypted Checkout
          </p>
        </div>
      </div>
      {%- endform -%}

    {%- else -%}
      <!-- Empty Cart -->
      <div class="cart-empty">
        <svg class="cart-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <h2 class="cart-empty__heading">Your cart is empty</h2>
        <p class="cart-empty__text">Looks like you haven't added anything yet.</p>
        <a href="/collections/all" class="btn btn--primary">Browse Collection</a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  async function updateCartLine(line, quantity) {
    const resp = await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line, quantity })
    });
    if (resp.ok) location.reload();
  }
</script>
