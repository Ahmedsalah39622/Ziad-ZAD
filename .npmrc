# ─── Hoisting ────────────────────────────────────────────────────────────────
node-linker=hoisted
hoist-pattern=*
shamefully-hoist=true
auto-install-peers=true

# ─── Build Scripts ───────────────────────────────────────────────────────────
ignore-scripts=false
enable-pre-post-scripts=true

# ─── Supply-Chain Policy ─────────────────────────────────────────────────────
minimum-release-age=0

# ─── npm fallback ────────────────────────────────────────────────────────────
legacy-peer-deps=true
unsafe-perm=true
build-from-source=false

