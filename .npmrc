# Hoisting - ensures proper dependency resolution (required for Next.js on Hostinger)
node-linker=hoisted
hoist-pattern=*
shamefully-hoist=true

# Allow native build scripts to run (required for Prisma, esbuild, sharp, etc.)
build-from-source=false
ignore-scripts=false

# Disable supply-chain age policy (prevents blocking recently published packages like es-toolkit)
minimum-release-age=0

# Skip native build failures for optional packages (e.g. @grandchef/node-printer requires CUPS on Linux)
optional-deps-timeout=0
ignore-optional-deps-errors=true
