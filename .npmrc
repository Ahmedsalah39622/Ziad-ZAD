# ─── Dependency Resolution ──────────────────────────────────────────────────
# Hoist all packages like npm (required for Next.js on Hostinger)
node-linker=hoisted
hoist-pattern=*
shamefully-hoist=true
auto-install-peers=true

# ─── Build Scripts ───────────────────────────────────────────────────────────
# Allow ALL dependencies to run their install/build scripts
ignore-scripts=false
build-from-source=false
# Explicitly enable pre/post install scripts (pnpm v10+)
enable-pre-post-scripts=true

# ─── Supply-Chain Policy ─────────────────────────────────────────────────────
# Disable the minimum release age check (unblocks recently published packages)
minimum-release-age=0

# ─── Optional Dependencies ───────────────────────────────────────────────────
# Silently skip failures from optional native packages (e.g. node-printer on Linux)
optional-deps-timeout=0
ignore-optional-deps-errors=true
